{
  "name": "bug-beep",
  "publisher": "knnemade99",
  "displayName": "Bug Beep",
  "description": "Plays a sound on save when errors, unused variables, or unused imports are detected.",
  "version": "0.1.0",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/knnemade99/bug-beep.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bug-beep.play",
        "title": "Bug Beep: Check and Play"
      }
    ],
    "configuration": {
      "title": "Bug Beep",
      "properties": {
        "bugBeep.soundFilePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom sound file (.wav, .mp3, .aiff, etc.). Leave empty to use the default built-in sound."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/node": "22.x",
    "eslint": "^9.39.3"
  }
}
